# ===================================================================
# Zyger ERP — Staging Environment Variables Template
# Tailored for staging.zygertechnology.in
# ===================================================================

# --- DATABASE CONFIGURATION ---
DB_NAME=zyger_erp
DB_USERNAME=zyger_staging
DB_PASSWORD=SecureStagingPassword2026!
DB_PORT=5433

# --- BACKEND SERVICE CONFIGURATION ---
# Match port in your company server config (8000 or 9090)
SERVER_PORT=8000
JWT_SECRET=EnterSuperSecretStagingKeyWithMinimum256BitsLengthHere!!
JWT_EXPIRATION_MS=28800000
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_MINUTES=5

# --- CORS & NETWORK ---
# Allowed origins for staging.zygertechnology.in
CORS_ORIGINS=http://staging.zygertechnology.in,https://staging.zygertechnology.in,http://localhost:9091

# --- SMTP / EMAIL NOTIFICATIONS ---
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=staging-alerts@company.com
SMTP_PASS=YourStagingSmtpPassword
MAIL_FROM=staging-alerts@company.com

# --- FRONTEND CONFIGURATION ---
FRONTEND_PORT=9091
VITE_API_BASE_URL=/api
