# =====================================================================
# Zyger ERP — Staging Environment Variables (EXAMPLE — do NOT commit secrets)
#
# Copy to .env.staging and fill in real values:
#   cp .env.staging.example .env.staging
#
# All values below are PLACEHOLDERS. NEVER commit a real .env.staging.
# Generate a strong JWT secret with:
#   openssl rand -base64 48
# =====================================================================

# ---------- Database (PostgreSQL 18) ----------
POSTGRES_DB=zyger_erp
POSTGRES_USER=zyger_staging
# STRONG random password (min 12 chars, mixed case, numbers, symbols)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---------- Spring profile ----------
SPRING_PROFILES_ACTIVE=staging

# ---------- JWT ----------
# STRONG random secret, at least 256 bits (32+ bytes). Generate:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TRULY_RANDOM_256_BIT_SECRET
# Token lifetime in milliseconds (default 30 days)
JWT_EXPIRATION_MS=2592000000

# ---------- Security ----------
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# STRONG password for the hidden ZygerAdmin fallback account (min 12 chars)
HIDDEN_ADMIN_PASSWORD=CHANGE_ME_STRONG_HIDDEN_ADMIN_PASSWORD

# ---------- CORS ----------
# EXACT staging origin(s), comma-separated. NO "*" for authenticated APIs.
# Example for local:  http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# ---------- Nginx public port ----------
NGINX_PORT=80

# ---------- Backend pool ----------
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=4

# ---------- Timezone / locale ----------
TZ=Asia/Kolkata

# ---------- SMTP (OPTIONAL — only if the app sends email) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
